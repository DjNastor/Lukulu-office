{
  "name": "lukulu-hq",
  "version": "42.1.0",
  "description": "Lukulu HQ development: operations, release review and desktop packaging",
  "private": true,
  "main": "main.js",
  "author": "Lukulu Recordings",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build-static.cjs",
    "test": "node --test tests/*.cjs",
    "build-win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.lukulurecordings.hq",
    "productName": "Lukulu HQ",
    "asar": true,
    "directories": {
      "output": "installers"
    },
    "files": [
      "main.js",
      "index.html",
      "operations.html",
      "review.html",
      "assets/**",
      "windows/link-policy.cjs",
      "package.json"
    ],
    "win": {
      "icon": "assets/lukulu.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Lukulu-HQ-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lukulu-HQ-Portable-${version}.${ext}"
    }
  }
}
