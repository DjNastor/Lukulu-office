{
  "name": "lukulu-hq",
  "version": "32.0.0",
  "description": "Lukulu Recordings Full Automation HQ v32 Global + Sync + Contracts + Easy Command + Voice",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "author": "Lukulu Recordings / Nhlakanipho Dlamini",
  "build": {
    "appId": "com.lukulurecordings.hq",
    "productName": "Lukulu HQ",
    "icon": "lukulu-real-icon-512.png",
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "lukulu-real-icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "lukulu-real-icon-512.png"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron": "^28.0.0"
  }
}